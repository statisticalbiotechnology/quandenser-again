{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/statisticalbiotechnology/quandenser-again/master/assets/schema_input.json",
    "title": "quandenser pipeline - params.input schema",
    "description": "Schema for the file provided with params.input",
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
            "sample": {
                "type": "string",
                "pattern": "^\\S+$",
                "errorMessage": "Sample name must be provided and cannot contain spaces",
                "meta": ["id"]
            },
            "mzml": {
                "type": "string",
                "format": "file-path",
                "exists": true,
                "pattern": "^\\S+\\.(mzML|mzml|mzML\\.gz)$",
                "errorMessage": "Path to a peak-picked mzML file, cannot contain spaces, must end in .mzML"
            },
            "condition": {
                "type": "string",
                "pattern": "^\\S+$",
                "errorMessage": "Condition cannot contain spaces",
                "meta": ["condition"]
            },
            "fraction": {
                "type": "integer",
                "minimum": 1,
                "errorMessage": "Fraction must be a positive integer",
                "meta": ["fraction"]
            }
        },
        "required": ["sample", "mzml"]
    }
}
