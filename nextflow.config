/*
 * nf-quandenser: label-free MS1 quantification with match-between-runs.
 *
 *   nextflow run statisticalbiotechnology/quandenser-again \
 *       -profile docker --input samplesheet.csv --outdir results
 */

params {

    // --- Input / output ------------------------------------------------
    input                       = null
    outdir                      = 'results'

    // --- Container -----------------------------------------------------
    // Built from containers/quandenser/Dockerfile in this repository. There
    // is no Quandenser package on bioconda or biocontainers, so unlike every
    // other tool in the pipeline this image has to come from here.
    quandenser_container        = 'ghcr.io/statisticalbiotechnology/quandenser:0.03.2'
    quandenser_version          = '0.03.2'
    // The binary resolves the Dinosaur jar through a path compiled in at
    // configure time (CMAKE_INSTALL_PREFIX + share/java), with no environment
    // override. Change this only alongside a differently configured image.
    quandenser_jar_path         = '/usr/share/java'

    // --- Quandenser ----------------------------------------------------
    prefix                      = 'Quandenser'
    seed                        = 1
    // Run Dinosaur as one task per file instead of serially inside Quandenser.
    parallel_feature_detection  = true
    // Defaults below are Quandenser's own (src/Quandenser.cpp:84-172).
    maracluster_pvalue_cutoff   = -10.0
    align_mz_tol                = 20.0
    align_rtime_tol             = 10.0
    intensity_score_cut         = 0.5
    ft_link_cut                 = 0.25
    percolator_train_fdr        = 0.02
    percolator_test_fdr         = 0.02
    // Number of candidates considered when matching features between runs.
    ft_link_candidates          = null
    // Minimum posterior error probability for re-searching a feature with a
    // targeted search. 1.0 skips the targeted search entirely, which is the
    // second most expensive stage in the tool.
    //
    // Both of these require a Quandenser built from this repository. In
    // released 0.03.2 the two options assign to each other's variables
    // (src/Quandenser.cpp:289-295), so they do not do what their help text
    // says; see docs/modularization.md.
    target_search_threshold     = null
    // Quandenser derives this from the run count when unset, which makes a
    // result depend on how many files were in the batch. Set it to pin it.
    max_missing                 = null
    quandenser_args             = null

    // --- Identification (opt-in) ---------------------------------------
    run_identification          = false
    fasta                       = null
    enzyme                      = 'trypsin/p'
    allowed_missed_cleavages    = 2
    precursor_mass_tolerance    = 20.0
    precursor_mass_tolerance_unit = 'ppm'

    // --- Triqler -------------------------------------------------------
    skip_triqler                = false
    fold_change_eval            = 0.8
    retain_unidentified         = true
    // Triqler's retention-time normalisation averages over a fixed 2000-point
    // window, so it fails on inputs that yield fewer feature groups than that.
    skip_normalization          = false

    // --- Boilerplate ---------------------------------------------------
    publish_dir_mode            = 'copy'
    monochrome_logs             = false

    // --- Resource ceilings ---------------------------------------------
    max_memory                  = '128.GB'
    max_cpus                    = 16
    max_time                    = '240.h'
}

profiles {
    debug {
        dumpHashes             = true
        process.beforeScript   = 'echo $HOSTNAME'
        cleanup                = false
    }
    docker {
        docker.enabled         = true
        docker.runOptions      = '-u $(id -u):$(id -g)'
        singularity.enabled    = false
        podman.enabled         = false
        apptainer.enabled      = false
        conda.enabled          = false
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
        podman.enabled         = false
        apptainer.enabled      = false
        conda.enabled          = false
    }
    apptainer {
        apptainer.enabled      = true
        apptainer.autoMounts   = true
        docker.enabled         = false
        singularity.enabled    = false
        podman.enabled         = false
        conda.enabled          = false
    }
    podman {
        podman.enabled         = true
        docker.enabled         = false
        singularity.enabled    = false
        apptainer.enabled      = false
        conda.enabled          = false
    }
    slurm {
        process.executor       = 'slurm'
    }
    test { includeConfig 'conf/test.config' }
}

// Loaded after the profiles so a profile that lowers max_cpus/max_memory
// (the test profile does) is reflected in the resource limits.
includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

// Keep numeric parsing independent of the host locale: these tools write and
// re-read decimal values in plain text.
env {
    LC_ALL = 'C'
    LANG   = 'C'
}

timeline {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_timeline.html"
    overwrite = true
}
report {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_report.html"
    overwrite = true
}
trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_trace.txt"
    overwrite = true
}
dag {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/pipeline_dag.html"
    overwrite = true
}

manifest {
    name            = 'statisticalbiotechnology/quandenser-again'
    author          = 'Lukas Käll, Matthew The'
    homePage        = 'https://github.com/statisticalbiotechnology/quandenser'
    description     = 'Quantification by distillation for enhanced signals with error regulation'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=23.10.0'
    version         = '0.03.2'
    doi             = '10.1038/s41467-020-17037-3'
}
