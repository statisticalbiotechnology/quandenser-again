/*
 * nf-quandenser: label-free MS1 quantification with match-between-runs.
 *
 *   nextflow run statisticalbiotechnology/quandenser-again \
 *       -profile docker --input samplesheet.csv --outdir results
 */

params {

    // --- Input / output ------------------------------------------------
    input                       = null
    outdir                      = 'results'

    // --- Container -----------------------------------------------------
    // Built from containers/quandenser/Dockerfile in this repository. There
    // is no Quandenser package on bioconda or biocontainers, so unlike every
    // other tool in the pipeline this image has to come from here.
    quandenser_container        = 'ghcr.io/statisticalbiotechnology/quandenser:0.03.2'
    quandenser_version          = '0.03.2'
    // The binary resolves the Dinosaur jar through a path compiled in at
    // configure time (CMAKE_INSTALL_PREFIX + share/java), with no environment
    // override. Change this only alongside a differently configured image.
    quandenser_jar_path         = '/usr/share/java'

    // --- Quandenser ----------------------------------------------------
    prefix                      = 'Quandenser'
    seed                        = 1
    // Run feature detection as one task per file instead of serially inside
    // Quandenser.
    parallel_feature_detection  = true
    // 'dinosaur' (default) or 'biosaur2', which also handles timsTOF data.
    // Quandenser still calls Dinosaur itself for its targeted match-between-
    // runs search; biosaur2 has no targeted mode and Dinosaur no ion
    // mobility, so on timsTOF set --target_search_threshold 1.0 to skip it.
    feature_detector            = 'dinosaur'
    biosaur2_container          = 'biosaur2:2e7c9a1'
    biosaur2_args               = null
    // Process each run in retention-time chunks of this many minutes
    // (bin/biosaur2_chunked.py). biosaur2 needs about 10 GB per GB of
    // ion-mobility MS1 mzML in one piece, so two-hour timsTOF runs need this.
    biosaur2_chunk_minutes      = null
    // Number of those chunks to run at once, each a biosaur2 process with
    // its own memory. Shortens a run's feature detection when there are
    // fewer runs than CPUs; the features do not depend on it.
    biosaur2_chunk_workers      = null
    // Drop biosaur2 features spanning fewer MS1 scans than this. Two-hour
    // timsTOF runs give about 1.8M features per run, too many for
    // Quandenser's feature matching in 32 GB; 6 keeps about half.
    biosaur2_min_scans          = null
    // Defaults below are Quandenser's own (src/Quandenser.cpp:84-172).
    maracluster_pvalue_cutoff   = -10.0
    align_mz_tol                = 20.0
    align_rtime_tol             = 10.0
    // Ion-mobility (1/K0) tolerance for matching features between runs. Only
    // biosaur2 on timsTOF data reports ion mobility, and only a Quandenser
    // built from this repository reads it; unset keeps matching on m/z and
    // retention time alone.
    align_im_tol                = null
    // Train Percolator on at most this many candidate pairs per feature-
    // matching step (Percolator's --subset-max-train) and score all pairs
    // with the trained weights, for runs with millions of candidate pairs.
    // Needs a Quandenser built from this repository; unset trains on all
    // pairs.
    align_max_train             = null
    // Number of runs whose clustered MS2 spectra MaRaCluster's consensus
    // step holds in memory at once, at least 2. Unset keeps MaRaCluster's
    // 40, which holds all runs of most experiments: six two-hour timsTOF
    // runs then need more than 32 GB. Needs a Quandenser built from this
    // repository.
    consensus_files_per_batch   = null
    intensity_score_cut         = 0.5
    ft_link_cut                 = 0.25
    percolator_train_fdr        = 0.02
    percolator_test_fdr         = 0.02
    // Number of candidates considered when matching features between runs.
    ft_link_candidates          = null
    // Minimum posterior error probability for re-searching a feature with a
    // targeted search. 1.0 skips the targeted search entirely, which is the
    // second most expensive stage in the tool.
    //
    // Both of these require a Quandenser built from this repository. In
    // released 0.03.2 the two options assign to each other's variables
    // (src/Quandenser.cpp:289-295), so they do not do what their help text
    // says; see docs/modularization.md.
    target_search_threshold     = null
    // Quandenser derives this from the run count when unset, which makes a
    // result depend on how many files were in the batch. Set it to pin it.
    max_missing                 = null
    // Tolerance scale MaRaCluster uses when merging peaks into consensus
    // spectra. 'thomson' is its own default, inherited from MS-Cluster and
    // written for ion traps; 'ppm' groups peaks within a fixed number of ppm
    // and never joins two peaks of one spectrum, which is what high-resolution
    // fragment spectra need. On PXD004863 fraction 9, 16.3% of the consensus
    // peaks produced by 'thomson' lie more than 10 ppm from any peak of any
    // member spectrum, against 0.0% for 'ppm'.
    //
    // These three need a Quandenser built against MaRaCluster with
    // statisticalbiotechnology/maracluster#35; an older binary stops with
    // "unknown option".
    consensus_method            = null
    consensus_ppm_tol           = null
    // 0 keeps every peak. The 160-peak cap is another MS-Cluster inheritance.
    consensus_max_peaks         = null
    quandenser_args             = null

    // --- Identification (opt-in) ---------------------------------------
    run_identification          = false
    fasta                       = null
    enzyme                      = 'trypsin/p'
    allowed_missed_cleavages    = 2
    precursor_mass_tolerance    = 20.0
    precursor_mass_tolerance_unit = 'ppm'

    // --- Triqler -------------------------------------------------------
    skip_triqler                = false
    fold_change_eval            = 0.8
    retain_unidentified         = true
    // Triqler's retention-time normalisation averages over a fixed 2000-point
    // window, so it fails on inputs that yield fewer feature groups than that.
    skip_normalization          = false

    // --- Boilerplate ---------------------------------------------------
    publish_dir_mode            = 'copy'
    monochrome_logs             = false

    // --- Resource ceilings ---------------------------------------------
    max_memory                  = '128.GB'
    max_cpus                    = 16
    max_time                    = '240.h'
}

profiles {
    debug {
        dumpHashes             = true
        process.beforeScript   = 'echo $HOSTNAME'
        cleanup                = false
    }
    docker {
        docker.enabled         = true
        docker.runOptions      = '-u $(id -u):$(id -g)'
        singularity.enabled    = false
        podman.enabled         = false
        apptainer.enabled      = false
        conda.enabled          = false
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
        podman.enabled         = false
        apptainer.enabled      = false
        conda.enabled          = false
    }
    apptainer {
        apptainer.enabled      = true
        apptainer.autoMounts   = true
        docker.enabled         = false
        singularity.enabled    = false
        podman.enabled         = false
        conda.enabled          = false
    }
    podman {
        podman.enabled         = true
        docker.enabled         = false
        singularity.enabled    = false
        apptainer.enabled      = false
        conda.enabled          = false
    }
    slurm {
        process.executor       = 'slurm'
    }
    test { includeConfig 'conf/test.config' }
}

// Loaded after the profiles so a profile that lowers max_cpus/max_memory
// (the test profile does) is reflected in the resource limits.
includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

// Keep numeric parsing independent of the host locale: these tools write and
// re-read decimal values in plain text.
env {
    LC_ALL = 'C'
    LANG   = 'C'
}

timeline {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_timeline.html"
    overwrite = true
}
report {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_report.html"
    overwrite = true
}
trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_trace.txt"
    overwrite = true
}
dag {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/pipeline_dag.html"
    overwrite = true
}

manifest {
    name            = 'statisticalbiotechnology/quandenser-again'
    author          = 'Lukas Käll, Matthew The'
    homePage        = 'https://github.com/statisticalbiotechnology/quandenser'
    description     = 'Quantification by distillation for enhanced signals with error regulation'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=23.10.0'
    version         = '0.03.2'
    doi             = '10.1038/s41467-020-17037-3'
}
