/*
 * Per-process publishing and extra arguments.
 *
 * Tool flags belong here rather than inside the process bodies, so that a
 * site can add an argument without editing a module.
 */

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: DINOSAUR {
        publishDir = [
            path: { "${params.outdir}/features" },
            mode: params.publish_dir_mode,
            // Flatten away the process-internal dinosaur/ directory.
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename.tokenize('/')[-1] }
        ]
    }

    withName: QUANDENSER {
        ext.args = params.quandenser_args ?: ''
        publishDir = [
            path: { "${params.outdir}/quandenser" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: TRIQLER {
        publishDir = [
            path: { "${params.outdir}/triqler" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
}
