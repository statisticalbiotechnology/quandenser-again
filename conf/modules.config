/*
 * Per-process publishing and extra arguments.
 *
 * Tool flags belong here rather than inside the process bodies, so that a
 * site can add an argument without editing a module.
 */

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: DINOSAUR {
        publishDir = [
            path: { "${params.outdir}/features" },
            mode: params.publish_dir_mode,
            // Flatten away the process-internal dinosaur/ directory.
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename.tokenize('/')[-1] }
        ]
    }

    withName: BIOSAUR2 {
        // Single process: the exact fast path only runs with -nprocs 1.
        cpus   = 1
        // A dense PASEF run (PXD039875 4448) peaks at 7.8 GB with biosaur2 as
        // released and at 14.6 GB with the centroiding fix, which forms about
        // twice as many candidate isotope clusters. Orbitrap runs need far less.
        memory = { 16.GB * task.attempt }
        ext.args = params.biosaur2_args ?: ''
        publishDir = [
            path: { "${params.outdir}/features" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename.tokenize('/')[-1] }
        ]
    }

    withName: QUANDENSER {
        ext.args = params.quandenser_args ?: ''
        publishDir = [
            path: { "${params.outdir}/quandenser" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: TRIQLER {
        publishDir = [
            path: { "${params.outdir}/triqler" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
}
