/*
 * Smoke test.
 *
 *   nextflow run . -profile test,docker --outdir results
 *
 * Three small BSA runs from the nf-core test-datasets repository, all from the
 * same fraction. Same fraction matters: the F1 and F2 files of these samples
 * share almost nothing (9-20 retention-time pairs against the 250 Quandenser
 * demands), so a samplesheet mixing fractions cannot produce a connected
 * spanning tree.
 *
 * Be aware of what this does and does not prove. It runs the real tools on
 * real data and exercises the container, the parallel feature detection, both
 * MaRaCluster passes and the retention-time alignment. It does **not** run to
 * completion: the dataset is too small for the targeted match-between-runs
 * search to find any target PSMs, and Percolator then exits with "no target
 * PSMs were provided".
 *
 * That stage could be skipped, in principle. Quandenser documents
 * --target-search-threshold 1.0 as doing exactly that, but the option assigns
 * to the wrong member (src/Quandenser.cpp:293-295), so the threshold it claims
 * to set is not reachable from the command line at all. Fixing that one line
 * upstream would let this profile run end to end; see docs/modularization.md.
 *
 * For a complete run, use a real experiment. The datasets from the Quandenser
 * paper are listed in docs/modularization.md.
 */

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check the pipeline runs end to end'

    max_cpus   = 2
    max_memory = '6.GB'
    max_time   = '2.h'

    input = "${projectDir}/assets/samplesheet_test.csv"

    // Quandenser refuses to align a pair of runs sharing fewer than 250
    // retention-time pairs, a hard-coded minimum in
    // src/AlignRetention.cpp:128. At the default clustering threshold these
    // files yield about 90-140 and the run stops. Loosening the MS2 clustering
    // gives 300-380, which is enough. This is a concession to the size of the
    // test data and not a setting to copy into a real analysis.
    maracluster_pvalue_cutoff = -3.0

    // A dataset this small yields far fewer than the 2000 feature groups that
    // Triqler's running-mean normalisation window needs, and it raises
    // IndexError rather than degrading gracefully.
    skip_normalization = true

    // Identification needs a FASTA, which the smoke test does not carry.
    run_identification = false
    skip_triqler       = true
}
